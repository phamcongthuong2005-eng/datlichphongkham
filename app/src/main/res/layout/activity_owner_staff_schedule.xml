<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Lịch Trình &amp; Ca Trực Nhân Viên"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Date selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem ngày:"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etScheduleDate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:paddingHorizontal="10dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Role Filter Buttons: Tất cả / Bác sĩ / Lễ tân / Nghỉ phép -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScheduleAll"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#0284C7"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnScheduleDoctors"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#F1F5F9"
                android:text="Bác sĩ"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:textSize="11sp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnScheduleStaff"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.2"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#F1F5F9"
                android:text="Lễ tân &amp; Y tá"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:textSize="11sp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnScheduleLeave"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:backgroundTint="#F1F5F9"
                android:text="Nghỉ phép"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:textSize="11sp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Summary Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bác sĩ trực:"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvCountDoctorOnDuty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="5 bác sĩ"
                    android:textColor="#0284C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lễ tân &amp; Y tá:"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvCountStaffOnDuty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="4 nhân viên"
                    android:textColor="#10B981"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nghỉ phép:"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvCountStaffOnLeave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 người"
                    android:textColor="#EF4444"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStaffSchedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
