<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/accent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNurseHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Y Tá: Phạm Thúy Hà"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điều Phối Hàng Đợi &amp; Đo Chỉ Số Sinh Hiệu"
                    android:textColor="#CCFBF1"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivNurseLogout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_status"
                android:backgroundTint="#0F766E"
                android:padding="6dp"
                android:src="@android:drawable/ic_lock_power_off"
                app:tint="@color/white" />
        </RelativeLayout>

        <!-- Current Calling Banner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCurrentCallingNumber"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_slot_available"
                    android:gravity="center"
                    android:text="#1"
                    android:textColor="@color/accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCurrentCallingPatient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bệnh nhân: Nguyễn Hữu Hậu"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentCallingRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mời vào: Phòng Khám Nội 1 (P101)"
                        android:textColor="@color/accent"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRecallPatient"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/accent"
                    android:text="🔊 Gọi lại"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Search & Filter bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etNurseSearch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="Tìm tên bệnh nhân, STT, SĐT..."
            android:inputType="text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCallNext"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary"
            android:text="📢 Gọi tiếp theo"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNurseQueueTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Danh Sách Bệnh Nhân Đang Chờ Đo Sinh Hiệu &amp; Khám (0)"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNurseEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Hiện tại không có bệnh nhân nào trong hàng đợi."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- RecyclerView for Nurse queue -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNurseQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:paddingVertical="4dp" />
</LinearLayout>
